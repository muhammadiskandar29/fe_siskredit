generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://neondb_owner:npg_CupYO5eAX4gk@ep-orange-scene-bb16eze3-pooler.c-15.us-east-1.aws.neon.tech/neondb?channel_binding=require&connect_timeout=15&sslmode=require"
}

model User {
  id                   Int               @id @default(autoincrement())
  nik                  String            @unique
  name                 String
  email                String            @unique
  password             String
  role                 String            @default("anggota") // 'petugas_simpin', 'ketua_koperasi', 'anggota'
  unit_kerja           String?
  status_pegawai       String?
  masa_kerja_tahun     Int               @default(0)
  no_hp                String?
  no_rekening_muamalat String?
  nama_rekening        String?
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt
  loans                LoanApplication[]
  approvalLogs         ApprovalLog[]
  notifications        Notification[]

  @@map("users")
}

model Criterion {
  id                Int            @id @default(autoincrement())
  code              String         @unique // C1, C2, C3, C4, C5
  name              String
  type              String         @default("benefit") // 'benefit' or 'cost'
  weight            Float          @default(20.0)
  normalized_weight Float          @default(0.20)
  order_num         Int            @default(1)
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt
  subCriteria       SubCriterion[]

  @@map("criteria")
}

model SubCriterion {
  id           Int       @id @default(autoincrement())
  criterion_id Int
  label        String
  min_val      Float?
  max_val      Float?
  score        Float     @default(1.0)
  description  String?
  order_num    Int       @default(1)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  criterion    Criterion @relation(fields: [criterion_id], references: [id], onDelete: Cascade)

  @@map("sub_criteria")
}

model LoanApplication {
  id                 Int               @id @default(autoincrement())
  user_id            Int
  nomor_pengajuan    String            @unique
  nominal_pengajuan  Float
  tenor_bulan        Int
  tujuan_pinjaman    String
  sisa_thp_persen    Float
  simpanan_wajib     Float
  status_pegawai     String
  masa_kerja_tahun   Int
  riwayat_pinjaman   String
  metode_pembayaran  String            @default("potong_gaji") // 'potong_gaji' atau 'transfer_manual'
  status             String            @default("pending") // pending, verified, rejected, approved, disbursed, completed
  verification_token String?           @unique
  catat_verifikasi   String?
  catat_approval     String?
  approved_at        DateTime?
  disbursed_at       DateTime?
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt
  user               User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  documents          LoanDocument[]
  evaluation         SmartEvaluation?
  installments       LoanInstallment[]
  approvalLogs       ApprovalLog[]

  @@map("loan_applications")
}

model LoanDocument {
  id                  Int             @id @default(autoincrement())
  loan_application_id Int
  document_type       String
  file_path           String
  original_filename   String?
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  loanApplication     LoanApplication @relation(fields: [loan_application_id], references: [id], onDelete: Cascade)

  @@map("loan_documents")
}

model SmartEvaluation {
  id                   Int              @id @default(autoincrement())
  loan_application_id  Int?             @unique
  alternative_code     String           @default("A1")
  candidate_name       String?
  candidate_nik        String?
  candidate_unit       String?
  candidate_plafon     Float?
  val_c1               Float            @default(0)
  val_c2               Float            @default(0)
  val_c3               Float            @default(0)
  val_c4               Float            @default(0)
  val_c5               Float            @default(0)
  utility_c1           Float            @default(0)
  utility_c2           Float            @default(0)
  utility_c3           Float            @default(0)
  utility_c4           Float            @default(0)
  utility_c5           Float            @default(0)
  final_score          Float            @default(0)
  rank                 Int              @default(0)
  recommendation       String?
  dynamic_scores       Json?
  is_manual_simulation Boolean          @default(false)
  is_delete            Int              @default(0)
  calculated_at        DateTime?
  created_at           DateTime         @default(now())
  updated_at           DateTime         @updatedAt
  loanApplication      LoanApplication? @relation(fields: [loan_application_id], references: [id], onDelete: Cascade)

  @@map("smart_evaluations")
}

model LoanInstallment {
  id                  Int             @id @default(autoincrement())
  loan_application_id Int
  angsuran_ke         Int
  jatuh_tempo         DateTime
  nominal_angsuran    Float
  kode_unik           Int?            @default(0)
  metode_bayar        String?         @default("potong_gaji") // potong_gaji, qris, transfer_manual
  status              String          @default("unpaid") // unpaid, pending_verification, paid
  bukti_transfer      String?
  paid_at             DateTime?
  confirmed_at        DateTime?
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  loanApplication     LoanApplication @relation(fields: [loan_application_id], references: [id], onDelete: Cascade)

  @@map("loan_installments")
}

model ApprovalLog {
  id                  Int             @id @default(autoincrement())
  loan_application_id Int
  approver_id         Int
  action              String
  notes               String?
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  loanApplication     LoanApplication @relation(fields: [loan_application_id], references: [id], onDelete: Cascade)
  approver            User            @relation(fields: [approver_id], references: [id], onDelete: Cascade)

  @@map("approval_logs")
}

model Notification {
  id         Int      @id @default(autoincrement())
  user_id    Int
  title      String
  message    String
  type       String   @default("info") // info, success, warning, danger
  link       String?
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}
